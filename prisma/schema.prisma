generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Enums ───────────────────────────

enum LawyerTitle {
  DOCTOR // دكتور
  ADVOCATE // محامي
}

enum LocationType {
  COURT // محكمة
  TAX_OFFICE // مكتب ضرائب
  COMMERCIAL_REGISTRY // سجل تجاري
  CIVIL_REGISTRY // السجل المدني
  PROSECUTION // نيابة
  LAWYERS_SYNDICATE // نقابة المحامين
  SURVEY_AUTHORITY // جهاز المساحة
  PASSPORTS // جوازات
  TRAFFIC // مرور
  SOCIAL_INSURANCE // التأمينات الاجتماعية
  LABOR_OFFICE // مكتب العمل
  CUSTOMS // جمارك
  INVESTMENT_AGENCY // هيئة الاستثمار
  EXPERTS_OFFICE // مكتب الخبراء
  REAL_ESTATE_REGISTRATION // الشهر العقاري
  GOVERNMENT_AGENCY // جهة حكومية
  OTHER // أخرى
}

enum TaskStatus {
  PENDING // قيد التنفيذ
  IN_PROGRESS // جاري التنفيذ
  COMPLETED // تم التنفيذ
  CANCELLED // ملغي
}

enum UserRole {
  ADMIN // legacy alias — treated as SUPER_ADMIN
  SUPER_ADMIN
  OFFICE_MANAGER
  LAWYER
  SECRETARY
  VIEWER
}

// ─────────────────────────── Users / Auth ───────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  comments      Comment[]
  notifications Notification[]
  tasks         Task[]
  activities    ActivityLog[]

  @@map("users")
}

model Lawyer {
  id              String      @id @default(cuid())
  slug            String      @unique
  fullName        String
  title           LawyerTitle
  phone           String?
  email           String?
  specialization  String?
  bio             String?
  active          Boolean     @default(true)
  sortOrder       Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tasks           TaskAssignment[]
  comments        Comment[]
  activities      ActivityLog[]
  notifications   Notification[]
  authSessions    AuthSession[]

  @@index([active, sortOrder])
  @@map("lawyers")
}

model Location {
  id                  String       @id @default(cuid())
  name                String
  nameEn              String?
  type                LocationType
  subType             String?
  governorate         String?
  city                String?
  district            String?
  phone               String?
  email               String?
  website             String?
  googleMapsUrl       String?
  lat                 Float?
  lng                 Float?
  workingHours        String?
  services            String[]     @default([])
  jurisdiction        String?
  requiresPersonal    Boolean      @default(false)
  hasOnlineService    Boolean      @default(false)
  source              String?
  lastVerified        DateTime?
  confidence          Int?
  distanceFromDokki   Float?
  distanceBucket      Int?
  buildingId          String?
  searchKeywords     String[]      @default([])
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  tasks              Task[]

  @@index([type])
  @@index([governorate, city, district])
  @@index([distanceBucket])
  @@map("locations")
}

model CaseRecord {
  id          String   @id @default(cuid())
  caseNumber String
  title       String
  court       String?
  client      String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks       Task[]

  @@index([caseNumber])
  @@map("cases")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  taskType    String?
  status      TaskStatus @default(PENDING)
  dueDate     DateTime?
  dueTime     String?
  notes       String?
  locationId  String?
  caseId      String?
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  location    Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  caseRecord  CaseRecord?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  assignments TaskAssignment[]
  comments    Comment[]
  activities  ActivityLog[]

  @@index([dueDate, status])
  @@index([locationId])
  @@index([caseId])
  @@map("tasks")
}

model TaskAssignment {
  id        String   @id @default(cuid())
  taskId    String
  lawyerId  String
  createdAt DateTime @default(now())

  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  lawyer    Lawyer @relation(fields: [lawyerId], references: [id], onDelete: Cascade)

  @@unique([taskId, lawyerId])
  @@index([lawyerId])
  @@map("task_assignments")
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  taskId    String?
  userId    String?
  lawyerId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  lawyer    Lawyer? @relation(fields: [lawyerId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@map("comments")
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  userId    String?
  lawyerId  String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lawyer    Lawyer? @relation(fields: [lawyerId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([lawyerId, readAt])
  @@map("notifications")
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  summary     String
  userId      String?
  lawyerId    String?
  taskId      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  lawyer      Lawyer? @relation(fields: [lawyerId], references: [id], onDelete: SetNull)
  task        Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([lawyerId, createdAt])
  @@map("activity_logs")
}

model AuthSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  role       String
  userRole   String?
  userId     String?
  lawyerId   String?
  ip         String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user       User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lawyer     Lawyer? @relation(fields: [lawyerId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@index([lawyerId])
  @@map("auth_sessions")
}
