# PostgreSQL (embedded instance started by scripts/pg-server.mjs)
DATABASE_URL="postgresql://lhl:lhl@localhost:5432/lhlawfirm"
SHADOW_DATABASE_URL="postgresql://lhl:lhl@localhost:5432/lhlawfirm_shadow"

# HMAC secret for session cookies — generate a long random string in real deployments
SESSION_SECRET="replace-with-a-long-random-secret"

# Admin account (password is NEVER shipped to the frontend)
ADMIN_NAME="DR. Hossam Lotfy"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-strong-password"

# Image uploads. Vercel production should use Vercel Blob (BLOB_READ_WRITE_TOKEN).
UPLOAD_DIR="storage/uploads"
MAX_UPLOAD_BYTES="4194304"

# Public site URL (used by robots.txt & sitemap.xml). Set on Vercel to the production domain.
NEXT_PUBLIC_SITE_URL="https://your-production-domain.vercel.app"

# Canonical public origin used by Google OAuth redirects and e-mail deep links.
NEXT_PUBLIC_APP_URL="https://your-production-domain.vercel.app"

# Gmail lawyer login (Google OAuth web application credentials).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP for e-mail reminders / approval notices (Gmail App Password recommended).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Comma-separated admin e-mails notified about new pending lawyer registrations.
ADMIN_NOTIFY_EMAILS=""

# Shared secret used by the Vercel cron (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=""

# Vercel Blob is required for persistent uploads in production.
# BLOB_READ_WRITE_TOKEN=""

# Demo data (local development only!) — set DEMO=1 to seed demo lawyers/tasks
# DEMO=1
