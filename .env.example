# PostgreSQL (embedded instance started by scripts/pg-server.mjs)
DATABASE_URL="postgresql://lhl:lhl@localhost:5432/lhlawfirm"
SHADOW_DATABASE_URL="postgresql://lhl:lhl@localhost:5432/lhlawfirm_shadow"

# HMAC secret for session cookies — use a long random string in real deployments
SESSION_SECRET="change-me-to-a-long-random-string"

# Admin account (password is NEVER shipped to the frontend)
ADMIN_NAME="DR. Hossam Lotfy"
ADMIN_EMAIL="admin@loutfilawfirm.net"
ADMIN_PASSWORD="ChangeMe_StrongPass!2026"

# Image uploads (stored outside the repo, served via /uploads/[file])
UPLOAD_DIR="storage/uploads"
MAX_UPLOAD_BYTES="5242880"

# Public site URL (used by robots.txt & sitemap.xml). Set on Vercel to the
# production domain, e.g. https://dr-hossam-lotfy-hw88-aamrabdelhays-projects.vercel.app
NEXT_PUBLIC_SITE_URL="https://dr-hossam-lotfy-hw88-aamrabdelhays-projects.vercel.app"

# Demo data (local development only!) — set DEMO=1 to seed demo lawyers/tasks
# DEMO=1
