# PostgreSQL (embedded instance started by scripts/pg-server.mjs)
# For production (Neon): use pooled URL with ?sslmode=require
DATABASE_URL="postgresql://lhl:lhl@localhost:5432/lhlawfirm"
SHADOW_DATABASE_URL="postgresql://lhl:lhl@localhost:5432/lhlawfirm_shadow"

# HMAC secret for session cookies — use a long random string in real deployments
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Admin account (password is NEVER shipped to the frontend)
# In production, ADMIN_PASSWORD is REQUIRED — seed will throw if missing
ADMIN_NAME="DR. Hossam Lotfy"
ADMIN_EMAIL="admin@loutfilawfirm.net"
ADMIN_PASSWORD="ChangeMe_StrongPass!2026"

# Image uploads (stored outside the repo, served via /uploads/[file])
UPLOAD_DIR="storage/uploads"
MAX_UPLOAD_BYTES="5242880"

# Vercel Blob (optional — for production file persistence)
# When BLOB_READ_WRITE_TOKEN is set, uploads go to Vercel Blob instead of local FS
# Get from Vercel Dashboard → Storage → Blob → .env
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Public site URL (used by robots.txt & sitemap.xml, and lawyer access links)
# Set on Vercel to the production domain, e.g. https://dr-hossam-lotfy.vercel.app
NEXT_PUBLIC_SITE_URL="https://dr-hossam-lotfy-hw88-aamrabdelhays-projects.vercel.app"
# Legacy alias (prefer SITE_URL, but BASE_URL still works as fallback)
# NEXT_PUBLIC_BASE_URL="https://dr-hossam-lotfy-hw88-aamrabdelhays-projects.vercel.app"

# Vercel deployment helpers (optional)
# SEED_ON_BUILD=1 → run prisma/seed.ts once during vercel-build (production-safe, DEMO is forced empty)
# SKIP_DB_MIGRATE=1 → emergency only: skip migrations in vercel-build (use after manual migration)
# SEED_ON_BUILD=1
# SKIP_DB_MIGRATE=1

# Demo data (local development only!) — set DEMO=1 to seed demo lawyers/tasks
# Never set DEMO=1 in production!
# DEMO=1

